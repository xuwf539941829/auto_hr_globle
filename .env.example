# ==========================================
# Docker & Registry 配置
# ==========================================
REGISTRY=docker.io
IMAGE_NAME=auto-hr-backend
TAG=latest

# ==========================================
# 后端服务配置
# ==========================================
BACKEND_PORT=8000

# CORS 配置：允许的来源（逗号分隔）
# Cloudflare Pages 域名 + 本地开发地址
CORS_ORIGINS=https://auto-hr.pages.dev,http://localhost:3000

# ==========================================
# LLM 配置（可选）
# ==========================================
# LLM API 密钥 (从 OpenAI 或其他兼容服务获取)
AUTO_HR_LLM_API_KEY=

# LLM 基础 URL (Zhipu GLM 示例)
AUTO_HR_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称
AUTO_HR_LLM_MODEL=gpt-4-mini

# API 风格: chat_completions 或 responses
AUTO_HR_LLM_API_STYLE=chat_completions

# 请求超时（秒）
AUTO_HR_LLM_TIMEOUT_SECONDS=45
